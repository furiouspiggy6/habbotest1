{
  "name": "habbo-nft-market-radar",
  "version": "2.0.8",
  "private": true,
  "type": "module",
  "description": "Windows desktop Habbo NFT scanner with live Immutable data and native automatic updates",
  "scripts": {
    "start": "electron .",
    "start:legacy": "node server.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "productName": "Habbo NFT Market Radar",
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.furiouspiggy6.habbomarketradar",
    "productName": "Habbo NFT Market Radar",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.ico",
    "files": [
      "desktop/**/*",
      "core.mjs",
      "market.mjs",
      "trade.mjs",
      "server.mjs",
      "updates.mjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Habbo-NFT-Market-Radar-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "furiouspiggy6",
        "repo": "habbotest1",
        "releaseType": "release"
      }
    ]
  }
}
